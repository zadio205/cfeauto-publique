# Facultatif : copier vers .env pour changer ces réglages.
# Aucun mot de passe impots.gouv.fr ici : la connexion se fait à la main dans la fenêtre du robot.

# Rappel quotidien (0-23) : une collecte démarre et attend votre connexion. Vide = lancement manuel.
CFEAUTO_SCHEDULE_HOUR=
# Délai laissé pour se connecter dans la fenêtre, en secondes
CFEAUTO_LOGIN_TIMEOUT=600
# Pause entre deux actions sur le site, en secondes
CFEAUTO_ACTION_DELAY=1.5
# Conseillé : protège l'interface si plusieurs personnes utilisent cet ordinateur
CFEAUTO_WEB_USER=cabinet
CFEAUTO_WEB_PASSWORD=
# Copie des avis avec des noms lisibles (ex. C:\Cabinet\Avis CFE). Vide = pas d'export.
CFEAUTO_EXPORT_DIR=export
